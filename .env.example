# ==============================================================================
# WatchWise — Example Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# TMDB API Key (Optional — leave blank to use automatic Cinemeta/IMDb/Wikipedia fallback)
TMDB_API_KEY="your_tmdb_api_key_here"

# Multi-API Poster Services
CINEMETA_API_URL="https://v3-cinemeta.strem.io/catalog/movie/top/search"
IMDB_SUGGEST_URL="https://v3.sg.media-imdb.com/suggestion"
WIKIPEDIA_API_URL="https://en.wikipedia.org/api/rest_v1/page/summary"

# Application Settings
STREAMLIT_SERVER_PORT="8501"
STREAMLIT_SERVER_HEADLESS="true"
